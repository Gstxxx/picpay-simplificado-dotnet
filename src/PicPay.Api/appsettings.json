{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "Seed": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Authorizer": {
    "BaseUrl": "https://util.devi.tools",
    "Path": "/api/v2/authorize",
    "TimeoutSeconds": 3,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 200
  },
  "Notifier": {
    "BaseUrl": "https://util.devi.tools",
    "Path": "/api/v1/notify",
    "TimeoutSeconds": 5,
    "MaxRetries": 2,
    "RetryDelayMilliseconds": 500
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalMilliseconds": 2000,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelaySeconds": 600
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "TransferBurst": 20,
    "TransferTokensPerMinute": 30
  },
  "Jwt": {
    "Issuer": "picpay-simplificado",
    "Audience": "picpay-simplificado",
    "Secret": "",
    "ExpirationMinutes": 60
  }
}
